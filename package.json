{
  "name": "momentum",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src app tests",
    "format:check": "prettier --check src app tests",
    "test": "node --test 'tests/**/*.test.mjs' && vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
