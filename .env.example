# Public browser values — safe to commit this template, but never commit a filled .env file.
# Copy this file to .env and fill in real values from the Supabase project dashboard.
# Without these, the React app (/app/) will show a setup error on load.
# Legacy auth.js at / reads these from a separate mechanism and is not affected.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
